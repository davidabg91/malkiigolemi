{
  "manifest_version": 3,
  "name": "Малки и Големи: поръчки от Facebook",
  "short_name": "Поръчки от Facebook",
  "version": "1.4.0",
  "description": "Чете коментарите под постовете в групата и ги праща в сайта като заявки за поръчка.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Поръчки от Facebook"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "alarms", "idle", "power"],
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://web.facebook.com/*",
    "https://malkiigolemi.com/*",
    "https://www.malkiigolemi.com/*",
    "http://localhost:3000/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.facebook.com/*", "https://web.facebook.com/*"],
      "js": ["scrape.js", "fb.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://malkiigolemi.com/*", "https://www.malkiigolemi.com/*", "http://localhost:3000/*"],
      "js": ["site.js"],
      "run_at": "document_idle"
    }
  ]
}
