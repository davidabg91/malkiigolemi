# Copy to .env.local and fill in. On Vercel these are set in Settings → Environment Variables (see DEPLOY.md).

# Database. Local SQLite file by default; on Vercel the Turso integration sets
# TURSO_DATABASE_URL / TURSO_AUTH_TOKEN instead, which are read automatically.
DATABASE_URL=file:./data/limona.db
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=

# Product photos. Without a Blob store they are saved to data/uploads (local only).
# Connecting Vercel Blob in the dashboard sets this for you.
# BLOB_READ_WRITE_TOKEN=

SESSION_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
